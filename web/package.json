{
  "name": "kernwacht",
  "version": "3.13.0",
  "description": "KERNWACHT – Welten unter Belagerung: isometrisches Tower-Defense für Browser (Desktop & Mobile)",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/build.mjs --dev --serve",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/serve.mjs dist 4173",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test tests/*.test.ts",
    "balance": "node --import tsx scripts/balance.ts",
    "balance:hero": "node --import tsx scripts/heroBalance.ts",
    "e2e": "node scripts/e2e.mjs",
    "check": "npm run typecheck && npm test && npm run build && npm run e2e"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "playwright": "^1.56.0",
    "tsx": "^4.20.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}
